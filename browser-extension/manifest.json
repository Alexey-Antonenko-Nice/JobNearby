{
  "manifest_version": 3,
  "name": "Job Nearby Capture",
  "version": "0.1.0",
  "description": "Capture the current page into the local Job Nearby observation store.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:4317/*"],
  "action": {
    "default_title": "Capture with Job Nearby",
    "default_popup": "popup.html"
  }
}
