{
  "name": "job-nearby",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "audit:licenses": "node tools/auditLicenses.cjs",
    "audit:licenses:write": "node tools/auditLicenses.cjs --write",
    "check:repo": "git ls-files | node tools/checkRepositoryHygiene.cjs",
    "check:fixtures": "node tools/checkFixtures.cjs",
    "check:history": "node tools/checkHistory.cjs",
    "check:contributor": "npm run check:repo && npm run check:fixtures && npm run check:history && npm run audit:licenses && npm run typecheck && npm run build && npm run ui:build",
    "capture:server": "npm run build && node dist/infrastructure/http/runBrowserCaptureServer.js",
    "copilot:mcp": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/infrastructure/mcp/runCopilotMcpServer.ts",
    "desktop:build": "npm run build && npm run ui:build",
    "desktop:rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "desktop": "npm run desktop:build && npm run desktop:rebuild-native && electron desktop/main.cjs",
    "desktop:clean": "node tools/cleanDesktopArtifacts.cjs",
    "desktop:package": "npm run desktop:clean && npm run desktop:build && npm run desktop:rebuild-native && electron-builder --win nsis --x64 --publish never && node tools/writeInstallerChecksum.cjs && node tools/verifyPackagedLegal.cjs",
    "verify:packaged-legal": "node tools/verifyPackagedLegal.cjs",
    "package:verify": "node tools/verifyReleaseArtifact.cjs",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "test:security": "vitest run tests/security tests/acquisition/popupPairing.test.js",
    "test:ci": "node tools/testCi.cjs",
    "prediagnose:captures": "npm run build",
    "diagnose:captures": "node dist/infrastructure/database/reportRecentCaptures.js job-nearby.sqlite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:watch": "vitest tests"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "jsdom": "^28.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zod": "^4.4.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.jobnearby.desktop",
    "productName": "Job Nearby",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "dist/**/*",
      "ui/dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*",
      "!tests/**",
      "!**/fixtures/**",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
      "!node_modules/better-sqlite3/prebuilds/linux*.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
      "!**/*.sqlite",
      "!**/*.db",
      "!**/.env*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Job Nearby",
      "artifactName": "Job-Nearby-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Job Nearby"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@42.11.18": true
  }
}
